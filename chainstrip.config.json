{
  "target": ".",
  "stateDir": ".chainstrip",
  "sandbox": {
    "mode": "enforce",
    "allowDegraded": true
  },
  "devPaths": [
    "apps/uikit-playground",
    "packages/release-action",
    "packages/release-changelog",
    "packages/jest-presets",
    "packages/storybook-config"
  ],
  "suites": [
    {
      "name": "jest",
      "testCommand": [
        "yarn",
        "run",
        ".testunit:jest"
      ],
      "testCwd": "apps/meteor",
      "testRunner": "jest"
    },
    {
      "name": "mocha",
      "testCommand": [
        "yarn",
        "run",
        ".testunit:server"
      ],
      "testCwd": "apps/meteor",
      "testRunner": "mocha"
    },
    {
      "name": "pkg-gazzodown",
      "testCommand": [
        "yarn",
        "workspace",
        "@rocket.chat/gazzodown",
        "run",
        "testunit"
      ],
      "testCwd": "packages/gazzodown",
      "testRunner": "jest"
    },
    {
      "name": "pkg-message-parser",
      "testCommand": [
        "yarn",
        "workspace",
        "@rocket.chat/message-parser",
        "run",
        "testunit"
      ],
      "testCwd": "packages/message-parser",
      "testRunner": "jest"
    }
  ],
  "buildCommand": [
    "yarn",
    "run",
    "build:ci"
  ],
  "buildCwd": "apps/meteor",
  "covtoolchain": {
    "commands": [
      [
        "yarn",
        "run",
        "build:ci"
      ]
    ],
    "cwd": "apps/meteor"
  },
  "update": {
    "block": [
      "retained-surface-changed",
      "validation-regression",
      "capability-escalation",
      "manual-review-required",
      "expanded-usage-vulnerable",
      "new-dependency",
      "reachable-cve"
    ]
  },
  "witness": {
    "llm": {
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    },
    "suite": "mocha",
    "probeDir": "apps/meteor/.chainstrip-probes"
  },
  "e2e": {
    "servicesUp": [
      "bash",
      "deploy/e2e-services.sh",
      "up"
    ],
    "servicesDown": [
      "bash",
      "deploy/e2e-services.sh",
      "down"
    ],
    "buildFirst": false,
    "serverCommand": [
      "meteor",
      "--exclude-archs",
      "web.browser.legacy, web.cordova"
    ],
    "serverCwd": "apps/meteor",
    "readyUrl": "http://localhost:3000/livez",
    "readyTimeoutMs": 1800000,
    "testCommand": [
      "bash",
      "deploy/e2e-suite.sh"
    ],
    "testCwd": ".",
    "env": {
      "TEST_MODE": "api",
      "MONGO_URL": "mongodb://localhost:27017/rocketchat?replicaSet=rs0&directConnection=true",
      "MOCK_SERVER_URL": "http://localhost:4000",
      "WEBHOOK_TEST_URL": "http://localhost:8081",
      "PLAYWRIGHT_BROWSERS_PATH": "0",
      "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE": "ubuntu24.04-x64",
      "E2E_UI_SPECS": "tests/e2e/homepage.spec.ts tests/e2e/account-profile.spec.ts tests/e2e/channel-management.spec.ts"
    },
    "gate": "report",
    "browserCoverage": true,
    "assets": [
      {
        "urlPrefix": "/node_modules/",
        "dir": "apps/meteor/node_modules"
      }
    ]
  }
}
